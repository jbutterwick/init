# ~/.config/llm/providers.env.example — template for providers.env.
# Copy to providers.env (chmod 600) and fill in keys. Never commit providers.env.
# Active provider name (must match a case arm in env.sh).
LLM_PROVIDER=xiaomi

# --- Xiaomi MiMo token-plan (default) ---
XIAOMI_BASE_URL=https://token-plan-sgp.xiaomimimo.com/anthropic
XIAOMI_API_KEY=
XIAOMI_MODEL=mimo-v2.6-pro

# --- DashScope ---
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/apps/anthropic
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen3.5-plus

# --- Placeholders (uncomment and fill to enable) ---
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_API_KEY=
# GEMINI_MODEL=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=
